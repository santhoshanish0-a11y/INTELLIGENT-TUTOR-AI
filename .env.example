# Choose ONE option. Without any of them the app runs in offline mode.

# Option A (FREE, no credit card): Groq.  Get a key at console.groq.com -> API Keys
GROQ_API_KEY=your_groq_key_here
 
# Option B (paid): Claude from Anthropic
# ANTHROPIC_API_KEY=

# Option C: any OpenAI-compatible service (OpenRouter, Google Gemini, Ollama on your own PC ...)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=llama3.2

# Optional: override the model name for the option you chose
# TUTOR_MODEL=